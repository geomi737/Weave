/* Обычные Qt-виджеты. Корпус нод и провода задаются в make_graph_style(). */
QWidget {
    color: #e4e9f2;
    font-family: "DejaVu Sans";
    font-size: 12px;
}
QMainWindow { background: #141820; }
QGraphicsView { border: none; }
QFrame#header { background: #1b202b; border-bottom: 1px solid #303746; }
QLabel#brand { font-size: 16px; font-weight: 700; }
QLabel#muted { color: #94a0b5; font-size: 10px; }
QWidget#nodePanel { background: transparent; }
QLabel { background: transparent; }
QLabel#nodeTitle { font-size: 14px; font-weight: 700; }
QLabel#fieldLabel { color: #94a0b5; font-size: 10px; font-weight: 600; }
QLabel#nodeStatus {
    color: #78d8ba;
    border-top: 1px solid #343d4d;
    padding-top: 12px;
    margin-top: 4px;
    font-size: 10px;
}
QLabel#note { color: #94a0b5; font-size: 11px; padding: 8px 0; }
QLineEdit, QComboBox, QDoubleSpinBox {
    background: #171c25;
    color: #e4e9f2;
    border: 1px solid #3a4355;
    border-radius: 5px;
    padding: 8px;
    selection-background-color: #6555aa;
}
QLineEdit:focus, QComboBox:focus { border-color: #a99bff; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #202632; selection-background-color: #514773; }
QPushButton {
    background: #303a4d;
    border: 1px solid #46536b;
    border-radius: 5px;
    padding: 9px;
    color: #e4e9f2;
}
QPushButton:hover { background: #3c4961; border-color: #8a7bce; }
QCheckBox { spacing: 8px; font-size: 11px; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background: #171c25;
    border: 1px solid #57647a;
    border-radius: 3px;
}
QCheckBox::indicator:checked { background: #a99bff; border: 3px solid #514773; }
QFrame#fractions { background: #171c25; border-radius: 5px; }
QFrame#fractions QLabel { color: #e9b97e; font-size: 11px; padding: 9px 0; }
QLabel#footer {
    background: #1b202b;
    border-top: 1px solid #303746;
    color: #94a0b5;
    font-size: 11px;
}
QMenu, QTreeWidget { background: #202632; color: #e4e9f2; }
QMenu::item:selected, QTreeWidget::item:selected { background: #514773; }
